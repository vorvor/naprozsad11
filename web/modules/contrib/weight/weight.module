<?php

/**
 * @file
 * Defines weight field types.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\weight\Hook\WeightHooks;
use Drupal\weight\Hook\WeightViewsHooks;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\field\FieldStorageConfigInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function weight_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(WeightHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_preprocess_views_view_table().
 */
#[LegacyHook]
function weight_preprocess_views_view_table(&$variables) {
  \Drupal::service(WeightHooks::class)->preprocessViewsViewTable($variables);
}

/**
 * Implements hook_field_views_data().
 */
#[LegacyHook]
function weight_field_views_data(FieldStorageConfigInterface $field_storage) {
  return \Drupal::service(WeightViewsHooks::class)->fieldViewsData($field_storage);
}
