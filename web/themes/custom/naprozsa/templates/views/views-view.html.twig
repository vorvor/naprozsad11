{% set classes = ['view', 'view-' ~ id|clean_class, 'view-display-id-' ~ display_id|clean_class, dom_id ? 'js-view-dom-id-' ~ dom_id] %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}{{ title }}{{ title_suffix }}
  {% if header %}<div class="view-header">{{ header }}</div>{% endif %}
  {{ exposed }}{{ attachment_before }}
  {% if rows %}<div class="view-content">{{ rows }}</div>{% elseif empty %}<div class="view-empty">{{ empty }}</div>{% endif %}
  {{ pager }}{{ attachment_after }}{{ more }}
  {% if footer %}<div class="view-footer">{{ footer }}</div>{% endif %}
  {{ feed_icons }}
</div>
